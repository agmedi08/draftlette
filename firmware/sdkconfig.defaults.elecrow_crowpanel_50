# CMakePresets.json board defaults: Elecrow CrowPanel ESP32 HMI 5.0in Display
# Sets the hardware model and IDF target used by the "elecrow_crowpanel_50" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_ELECROW_CROWPANEL_50=y

# ESP32-S3-WROOM-1-N4R8: 4 MB flash (8 MB octal PSRAM, the
# sdkconfig.defaults.esp32s3 default). Override the 16 MB flash size
# and the shared partitions.csv (whose 14 MB factory partition does
# not fit) with the 4 MB layout.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# DIO works with every flash chip; the module has not been checked
# with the QIO default from sdkconfig.defaults.esp32s3 yet.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Enable the on-board GT911 touchscreen as a secondary input device.
CONFIG_DRAFTLING_TOUCHSCREEN=y
